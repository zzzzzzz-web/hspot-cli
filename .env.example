# HubSpot private app access token.
# Create one at: HubSpot > Settings > Integrations > Private Apps.
# See the README for the exact scopes each command needs.
#
# Copy this file to `.env` and fill in your token:
#   cp .env.example .env
#
# Either variable name works; HUBSPOT_TOKEN takes precedence if both are set.
HUBSPOT_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# HUBSPOT_PRIVATE_APP_TOKEN=pat-na1-...
